{
  "name": "drinks",
  "version": "5.1.0",
  "private": true,
  "description": "Craft Cocktail Gallery",
  "bugs": {
    "url": "https://github.com/wKovacs64/drinks/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Justin Hall",
    "email": "justin.r.hall@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/wKovacs64/drinks.git"
  },
  "type": "module",
  "sideEffects": false,
  "imports": {
    "#/*": "./*"
  },
  "scripts": {
    "dev": "pnpm build:styles && NODE_ENV=development node --env-file-if-exists=.env scripts/dev.ts",
    "build": "pnpm build:styles && pnpm typecheck",
    "build:styles": "node scripts/prepare-assets.ts && tailwindcss -i app/assets/app.css -o public/app.css --minify",
    "start": "NODE_ENV=production node --env-file-if-exists=.env --import remix/node-tsx server.ts",
    "lint": "oxlint",
    "typecheck": "tsc --noEmit",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "doctor": "remix doctor --strict",
    "validate": "pnpm format:check && pnpm lint && pnpm doctor && pnpm typecheck && pnpm test",
    "test": "pnpm build:styles && node --env-file=.env.test node_modules/remix/dist/cli-entry.js test",
    "test:watch": "pnpm test --watch",
    "db:migrate": "node --env-file-if-exists=.env node_modules/remix/dist/cli-entry.js db migrate",
    "db:status": "node --env-file-if-exists=.env node_modules/remix/dist/cli-entry.js db status",
    "assets:inspect": "node node_modules/remix/dist/cli-entry.js assets inspect"
  },
  "dependencies": {
    "@fontsource/source-sans-3": "5.3.1",
    "@imagekit/nodejs": "7.13.0",
    "@modelcontextprotocol/ext-apps": "2.0.3",
    "@modelcontextprotocol/server": "2.3.1",
    "@remix-run/ui": "0.13.0",
    "@sindresorhus/slugify": "3.0.1",
    "@unpic/core": "1.0.3",
    "lodash-es": "4.18.1",
    "marked": "18.1.1",
    "minisearch": "7.2.0",
    "remix": "3.1.0",
    "unpic": "4.2.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "@tailwindcss/cli": "4.3.3",
    "@types/lodash-es": "4.17.12",
    "@types/node": "26.6.5",
    "@wkovacs64/add-icon": "1.2.2",
    "@wkovacs64/oxlint-config": "0.4.0",
    "esbuild": "0.28.2",
    "msw": "3.0.3",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "oxlint-tsgolint": "7.0.2005",
    "playwright": "1.64.1",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=24.19"
  },
  "packageManager": "pnpm@12.15.0"
}
